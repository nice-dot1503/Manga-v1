# ============================================================================
# COPY THIS FILE TO .env.local (dev) / set these in your host's secret
# manager for production. NEVER commit a real .env file.
# ============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/manga_reader?schema=public"

# --- Session / Auth -----------------------------------------------------------
# 32+ random bytes, base64. Used to sign/verify session cookies.
SESSION_SECRET="generate-with-openssl-rand-base64-32"
SESSION_COOKIE_NAME="mr_session"

# --- Simple admin panel login (recommended for a solo operator) ---------------
# One shared password unlocks /admin — no user accounts to manage. Generate
# ADMIN_PASSWORD_HASH with:  node scripts/hash-admin-password.mjs "your-password"
# ADMIN_SESSION_SECRET just needs to be a random 32+ char string of your own choosing.
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET="generate-a-different-random-32-char-value"

# --- Cloudflare R2 (S3-compatible object storage) ------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="manga-reader-pages"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# Public-facing hostname used to build signed/proxied image URLs — never the
# raw R2 endpoint above.
R2_PUBLIC_IMAGE_HOST="images.yourdomain.com"

# --- Cloudflare Turnstile (CAPTCHA / anti-bot) ---------------------------------
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Payment provider (abstraction layer — pick ONE and fill its keys) --------
PAYMENT_PROVIDER="stripe" # or "omise", etc.
PAYMENT_PROVIDER_SECRET_KEY=""
PAYMENT_PROVIDER_WEBHOOK_SECRET=""

# --- Business / advertiser contact ---------------------------------------------
ADVERTISING_CONTACT_EMAIL="advertising@yourdomain.com"

# --- App -------------------------------------------------------------------
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"
